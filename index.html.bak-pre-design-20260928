<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JARVIS — Sistema de Inteligência & Second Brain</title>
  <style>
    /* ==========================================================================
       RESET & BASE SCI-FI THEME (PURPLE / ROXO REATOR)
       ========================================================================== */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg-deep: #06030c;
      --bg-panel: rgba(18, 10, 32, 0.7);
      --bg-panel-border: rgba(168, 85, 247, 0.25);
      --primary: #a855f7;
      --primary-glow: rgba(168, 85, 247, 0.45);
      --primary-bright: #c084fc;
      --primary-dark: #6b21a8;
      --accent-cyan: #22d3ee;
      --accent-green: #10b981;
      --accent-orange: #f97316;
      --accent-red: #ef4444;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
      --font-mono: ui-monospace, 'SF Mono', Menlo, Monaco, Consolas, 'Liberation Mono', monospace;
      --font-sans: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    }

    body {
      background-color: var(--bg-deep);
      background-image: 
        radial-gradient(circle at 50% 0%, rgba(147, 51, 234, 0.18) 0%, transparent 60%),
        radial-gradient(circle at 10% 80%, rgba(124, 58, 237, 0.1) 0%, transparent 45%),
        linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px);
      background-size: 100% 100%, 100% 100%, 40px 40px, 40px 40px;
      color: var(--text-main);
      font-family: var(--font-sans);
      min-height: 100vh;
      overflow-x: hidden;
      line-height: 1.5;
    }

    /* Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: var(--bg-deep);
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(168, 85, 247, 0.3);
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(168, 85, 247, 0.6);
    }

    /* ==========================================================================
       TELA 1: BOOT (SINCRONIZAÇÃO)
       ========================================================================== */
    #screen-boot {
      position: fixed;
      inset: 0;
      background: #040208;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      transition: opacity 0.8s ease, visibility 0.8s ease;
    }

    #screen-boot.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .boot-brand {
      font-family: var(--font-mono);
      font-size: clamp(3rem, 8vw, 5.5rem);
      font-weight: 900;
      letter-spacing: 0.35em;
      text-indent: 0.35em;
      text-transform: uppercase;
      background: linear-gradient(135deg, #e9d5ff 0%, #a855f7 45%, #6366f1 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 35px rgba(168, 85, 247, 0.5));
      margin-bottom: 20px;
    }

    .boot-line {
      width: min(85vw, 480px);
      height: 1px;
      border: 0;
      background: linear-gradient(90deg, transparent 0%, #a855f7 50%, transparent 100%);
      margin-bottom: 30px;
      box-shadow: 0 0 15px rgba(168, 85, 247, 0.8);
    }

    .boot-status {
      font-family: var(--font-mono);
      font-size: 0.95rem;
      letter-spacing: 0.28em;
      color: #c084fc;
      animation: blinkText 1.1s ease-in-out infinite alternate;
      text-shadow: 0 0 10px rgba(168, 85, 247, 0.7);
    }

    .boot-version {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      letter-spacing: 0.18em;
      color: var(--text-dim);
      margin-top: 25px;
    }

    @keyframes blinkText {
      0% { opacity: 0.3; transform: scale(0.98); }
      100% { opacity: 1; transform: scale(1); }
    }

    /* ==========================================================================
       TELA 2: ATIVAÇÃO (CLIQUE DO USUÁRIO)
       ========================================================================== */
    #screen-activation {
      position: fixed;
      inset: 0;
      background: rgba(4, 2, 8, 0.96);
      backdrop-filter: blur(20px);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 900;
      transition: opacity 0.7s ease, visibility 0.7s ease;
    }

    #screen-activation.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .activation-box {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 28px;
    }

    .btn-activate {
      position: relative;
      background: linear-gradient(135deg, rgba(168, 85, 247, 0.25) 0%, rgba(99, 102, 241, 0.15) 100%);
      border: 1px solid rgba(168, 85, 247, 0.6);
      color: #f3e8ff;
      padding: 18px 46px;
      font-family: var(--font-mono);
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      border-radius: 50px;
      cursor: pointer;
      box-shadow: 0 0 30px rgba(168, 85, 247, 0.35), inset 0 0 15px rgba(168, 85, 247, 0.2);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      display: inline-flex;
      align-items: center;
      gap: 12px;
    }

    .btn-activate:hover {
      transform: translateY(-2px) scale(1.03);
      border-color: #c084fc;
      background: linear-gradient(135deg, rgba(168, 85, 247, 0.45) 0%, rgba(99, 102, 241, 0.3) 100%);
      box-shadow: 0 0 45px rgba(168, 85, 247, 0.65), inset 0 0 20px rgba(168, 85, 247, 0.4);
    }

    .btn-activate:active {
      transform: scale(0.98);
    }

    .activation-sub {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      letter-spacing: 0.3em;
      color: var(--text-dim);
      animation: pulseSub 2.5s ease-in-out infinite;
    }

    @keyframes pulseSub {
      0%, 100% { opacity: 0.4; }
      50% { opacity: 0.9; }
    }

    /* ==========================================================================
       APLICAÇÃO PRINCIPAL (APP CONTAINER)
       ========================================================================== */
    #app-container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 24px 20px 60px;
      display: flex;
      flex-direction: column;
      gap: 32px;
      opacity: 0;
      transition: opacity 1s ease;
    }

    #app-container.visible {
      opacity: 1;
    }

    /* HUD Topbar */
    .hud-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      padding: 16px 24px;
      background: var(--bg-panel);
      border: 1px solid var(--bg-panel-border);
      border-radius: 14px;
      backdrop-filter: blur(12px);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    }

    .hud-identity {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .hud-pulse-dot {
      width: 12px;
      height: 12px;
      background: var(--primary);
      border-radius: 50%;
      box-shadow: 0 0 14px var(--primary);
      animation: pulseDot 2s infinite;
    }

    @keyframes pulseDot {
      0%, 100% { transform: scale(1); opacity: 0.8; }
      50% { transform: scale(1.3); opacity: 1; }
    }

    .hud-title {
      font-family: var(--font-mono);
      font-size: 1.1rem;
      font-weight: 700;
      letter-spacing: 0.15em;
      color: #f1f5f9;
    }

    .hud-subtitle {
      font-size: 0.75rem;
      color: var(--text-dim);
      font-family: var(--font-mono);
    }

    .hud-key-area {
      display: flex;
      align-items: center;
      gap: 10px;
      flex: 1;
      max-width: 440px;
    }

    .hud-input-key {
      flex: 1;
      background: rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(168, 85, 247, 0.35);
      color: #e2e8f0;
      padding: 9px 14px;
      border-radius: 8px;
      font-family: var(--font-mono);
      font-size: 0.85rem;
      outline: none;
      transition: all 0.2s;
    }

    .hud-input-key:focus {
      border-color: var(--primary);
      box-shadow: 0 0 15px rgba(168, 85, 247, 0.35);
    }

    .btn-key-save {
      background: rgba(168, 85, 247, 0.25);
      border: 1px solid rgba(168, 85, 247, 0.5);
      color: #e9d5ff;
      padding: 9px 16px;
      border-radius: 8px;
      font-family: var(--font-mono);
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      white-space: nowrap;
    }

    .btn-key-save:hover {
      background: rgba(168, 85, 247, 0.45);
      border-color: #c084fc;
      box-shadow: 0 0 12px rgba(168, 85, 247, 0.4);
    }

    /* REATOR / ORBE SCI-FI CENTRAL */
    .reactor-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      padding: 30px 20px 20px;
    }

    .orb-wrapper {
      position: relative;
      width: 240px;
      height: 240px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      user-select: none;
      margin-bottom: 24px;
    }

    /* Anéis Concêntricos Externos */
    .orb-ring-outer {
      position: absolute;
      inset: -20px;
      border: 1px dashed rgba(168, 85, 247, 0.25);
      border-radius: 50%;
      animation: rotateSlow 30s linear infinite;
    }

    .orb-ring-middle {
      position: absolute;
      inset: -8px;
      border: 1px solid rgba(168, 85, 247, 0.35);
      border-top-color: transparent;
      border-bottom-color: transparent;
      border-radius: 50%;
      animation: rotateReverse 18s linear infinite;
    }

    @keyframes rotateSlow {
      to { transform: rotate(360deg); }
    }
    @keyframes rotateReverse {
      to { transform: rotate(-360deg); }
    }

    /* Orbe Central */
    .orb-core {
      position: relative;
      width: 140px;
      height: 140px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #e9d5ff 0%, #a855f7 40%, #581c87 80%, #2e1065 100%);
      box-shadow: 
        0 0 40px rgba(168, 85, 247, 0.5),
        inset 0 0 30px rgba(255, 255, 255, 0.4),
        inset -10px -10px 25px rgba(0, 0, 0, 0.7);
      transition: all 0.4s ease;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .orb-core::after {
      content: '';
      position: absolute;
      inset: 12px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.4);
      filter: blur(1px);
    }

    /* Ondas de som / listening / talking ripples */
    .orb-ripple {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 2px solid var(--primary);
      opacity: 0;
      pointer-events: none;
    }

    /* Estados do Orbe */
    /* 1. Ocioso: pulso lento */
    .orb-wrapper.state-idle .orb-core {
      animation: orbPulseIdle 4.5s ease-in-out infinite;
    }
    @keyframes orbPulseIdle {
      0%, 100% { transform: scale(1); box-shadow: 0 0 35px rgba(168, 85, 247, 0.4); }
      50% { transform: scale(1.05); box-shadow: 0 0 55px rgba(168, 85, 247, 0.7); }
    }

    /* 2. Ouvindo: ondas concêntricas */
    .orb-wrapper.state-listening .orb-core {
      background: radial-gradient(circle at 35% 35%, #cffafe 0%, #22d3ee 40%, #0891b2 80%, #164e63 100%);
      box-shadow: 0 0 50px rgba(34, 211, 238, 0.6);
      animation: orbListen 1.5s ease-in-out infinite;
    }
    .orb-wrapper.state-listening .orb-ripple {
      border-color: #22d3ee;
      animation: rippleExpand 1.6s cubic-bezier(0, 0.2, 0.8, 1) infinite;
    }
    @keyframes orbListen {
      0%, 100% { transform: scale(1.02); }
      50% { transform: scale(1.12); }
    }
    @keyframes rippleExpand {
      0% { transform: scale(0.9); opacity: 0.8; }
      100% { transform: scale(2.2); opacity: 0; }
    }

    /* 3. Pensando: pulso rápido */
    .orb-wrapper.state-thinking .orb-core {
      background: radial-gradient(circle at 35% 35%, #fef08a 0%, #eab308 40%, #854d0e 80%, #422006 100%);
      box-shadow: 0 0 60px rgba(234, 179, 8, 0.75);
      animation: orbThinking 0.6s ease-in-out infinite alternate;
    }
    @keyframes orbThinking {
      0% { transform: scale(0.95); }
      100% { transform: scale(1.14); }
    }

    /* 4. Falando: ondas suaves */
    .orb-wrapper.state-speaking .orb-core {
      background: radial-gradient(circle at 35% 35%, #fbcfe8 0%, #ec4899 40%, #9d174d 80%, #500724 100%);
      box-shadow: 0 0 55px rgba(236, 72, 153, 0.7);
      animation: orbSpeak 1.1s ease-in-out infinite;
    }
    .orb-wrapper.state-speaking .orb-ripple {
      border-color: #ec4899;
      animation: rippleExpand 2s cubic-bezier(0, 0.2, 0.8, 1) infinite 0.4s;
    }
    @keyframes orbSpeak {
      0%, 100% { transform: scale(1.03); }
      50% { transform: scale(1.15); }
    }

    /* Status e Feedback de Diálogo */
    .hud-status-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 18px;
      background: rgba(168, 85, 247, 0.12);
      border: 1px solid rgba(168, 85, 247, 0.35);
      border-radius: 30px;
      font-family: var(--font-mono);
      font-size: 0.82rem;
      letter-spacing: 0.15em;
      color: #c084fc;
      margin-bottom: 20px;
    }

    .dialogue-box {
      width: 100%;
      max-width: 780px;
      background: var(--bg-panel);
      border: 1px solid var(--bg-panel-border);
      border-radius: 16px;
      padding: 20px 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      backdrop-filter: blur(14px);
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
    }

    .dialogue-line {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .dialogue-label {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.2em;
      color: var(--text-dim);
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .dialogue-label.user {
      color: #38bdf8;
    }

    .dialogue-label.assistant {
      color: #c084fc;
    }

    .dialogue-text {
      font-size: 1.02rem;
      color: #f1f5f9;
      min-height: 1.5em;
      word-break: break-word;
      transition: color 0.3s;
    }

    .dialogue-text.empty {
      color: var(--text-dim);
      font-style: italic;
    }

    /* Controles de Entrada (Texto & Botões de Voz) */
    .controls-bar {
      display: flex;
      align-items: center;
      gap: 12px;
      width: 100%;
      max-width: 780px;
      margin-top: 14px;
    }

    .input-text-command {
      flex: 1;
      background: rgba(18, 10, 32, 0.7);
      border: 1px solid rgba(168, 85, 247, 0.3);
      color: #f8fafc;
      padding: 14px 20px;
      border-radius: 12px;
      font-family: var(--font-sans);
      font-size: 0.95rem;
      outline: none;
      backdrop-filter: blur(10px);
      transition: all 0.2s;
    }

    .input-text-command:focus {
      border-color: var(--primary);
      box-shadow: 0 0 20px rgba(168, 85, 247, 0.3);
    }

    .btn-action-icon {
      background: rgba(168, 85, 247, 0.18);
      border: 1px solid rgba(168, 85, 247, 0.4);
      color: #e9d5ff;
      width: 50px;
      height: 50px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s;
      flex-shrink: 0;
    }

    .btn-action-icon:hover {
      background: rgba(168, 85, 247, 0.38);
      border-color: #c084fc;
      transform: translateY(-2px);
      box-shadow: 0 0 15px rgba(168, 85, 247, 0.45);
    }

    .btn-action-icon.danger {
      background: rgba(239, 68, 68, 0.18);
      border-color: rgba(239, 68, 68, 0.4);
      color: #fca5a5;
    }
    .btn-action-icon.danger:hover {
      background: rgba(239, 68, 68, 0.35);
      border-color: #f87171;
      box-shadow: 0 0 15px rgba(239, 68, 68, 0.45);
    }

    /* ==========================================================================
       SECOND BRAIN — GRAFO NEURAL ANIMADO
       ========================================================================== */
    .brain-section {
      background: var(--bg-panel);
      border: 1px solid var(--bg-panel-border);
      border-radius: 20px;
      padding: 24px;
      backdrop-filter: blur(16px);
      box-shadow: 0 12px 48px rgba(0, 0, 0, 0.5);
      display: flex;
      flex-direction: column;
      gap: 16px;
      position: relative;
    }

    .brain-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      border-bottom: 1px solid rgba(168, 85, 247, 0.15);
      padding-bottom: 14px;
    }

    .brain-title-box {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .brain-title {
      font-family: var(--font-mono);
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      color: #f8fafc;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brain-subtitle {
      font-size: 0.8rem;
      color: var(--text-dim);
      font-family: var(--font-mono);
    }

    .brain-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brain-counter {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      color: #c084fc;
      background: rgba(168, 85, 247, 0.12);
      padding: 6px 14px;
      border-radius: 20px;
      border: 1px solid rgba(168, 85, 247, 0.3);
    }

    .btn-brain-tool {
      background: rgba(168, 85, 247, 0.2);
      border: 1px solid rgba(168, 85, 247, 0.4);
      color: #e9d5ff;
      padding: 7px 15px;
      border-radius: 8px;
      font-family: var(--font-mono);
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .btn-brain-tool:hover {
      background: rgba(168, 85, 247, 0.4);
      border-color: #c084fc;
      box-shadow: 0 0 12px rgba(168, 85, 247, 0.4);
    }

    /* Container do SVG Neural */
    #graph-container {
      width: 100%;
      height: 520px;
      background: radial-gradient(circle at 50% 50%, rgba(26, 11, 46, 0.7) 0%, rgba(10, 4, 18, 0.95) 100%);
      border-radius: 14px;
      border: 1px solid rgba(168, 85, 247, 0.2);
      overflow: hidden;
      position: relative;
    }

    #graph-container svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    /* Animação das Arestas com dashoffset */
    .neural-edge {
      stroke-dasharray: 6 5;
      animation: dashStream 16s linear infinite;
    }
    @keyframes dashStream {
      from { stroke-dashoffset: 200; }
      to { stroke-dashoffset: 0; }
    }

    /* Nós Interativos */
    .node-group {
      cursor: pointer;
      transition: transform 0.25s ease;
    }
    .node-group:hover {
      filter: drop-shadow(0 0 12px rgba(255, 255, 255, 0.7));
    }
    .node-group:hover .node-circle {
      transform: scale(1.15);
    }

    /* Respiração do Nó (Breathing ring) */
    .breathing-ring {
      animation: nodeBreathe 3.5s ease-in-out infinite;
      transform-origin: center;
      pointer-events: none;
    }
    @keyframes nodeBreathe {
      0%, 100% { opacity: 0.25; transform: scale(1); }
      50% { opacity: 0.75; transform: scale(1.22); }
    }

    /* Piscar nó recém-salvo */
    .node-flash {
      animation: flashNode 0.5s ease-in-out 3;
    }
    @keyframes flashNode {
      0%, 100% { fill-opacity: 0.85; filter: drop-shadow(0 0 8px var(--primary)); }
      50% { fill-opacity: 1; fill: #ffffff !important; filter: drop-shadow(0 0 25px #ffffff); }
    }

    /* Legenda */
    .brain-legend {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 14px;
      font-size: 0.78rem;
      color: var(--text-dim);
      padding-top: 10px;
    }

    .legend-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .legend-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .legend-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }

    .legend-verified {
      color: var(--accent-green);
      font-family: var(--font-mono);
      font-weight: 600;
      letter-spacing: 0.05em;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* ==========================================================================
       MODAL DE EDIÇÃO / CRIAÇÃO DE NOTAS
       ========================================================================== */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(3, 1, 6, 0.8);
      backdrop-filter: blur(12px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1200;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
      padding: 16px;
    }

    .modal-overlay.open {
      opacity: 1;
      visibility: visible;
    }

    .modal-card {
      width: 100%;
      max-width: 520px;
      background: #0f081d;
      border: 1px solid rgba(168, 85, 247, 0.4);
      box-shadow: 0 15px 50px rgba(0, 0, 0, 0.8), 0 0 30px rgba(168, 85, 247, 0.25);
      border-radius: 18px;
